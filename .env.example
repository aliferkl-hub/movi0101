# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

PORT=3000
NODE_ENV=development
DISABLE_HMR=
PIX_CHAVE=
MERCADO_PAGO_ACCESS_TOKEN=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
PIX_API_TOKEN=

# Persistence layer ("json" by default until PostgreSQL homologation/cutover)
PERSISTENCE_MODE=json

# Cloud SQL PostgreSQL configuration (Object Method; use Secret Manager in Cloud Run)
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Administrative Master Owner password recovery key (configure via Secret Manager / server env only; never expose to frontend)
MASTER_RECOVERY_KEY=

# Optional dedicated first-access activation key for newly provisioned Master Owner accounts (falls back to MASTER_RECOVERY_KEY if unset)
MASTER_FIRST_ACCESS_KEY=

